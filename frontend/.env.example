# Copy this file to `.env.local` and fill in the values.

# Supabase project settings (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Canonical origin for SEO, sitemap.xml and Open Graph URLs.
# Defaults to https://dahabhostel.com when unset.
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# PostgreSQL / Drizzle ORM Connection String
# Session Pooler (port 5432 - recommended for migrations / drizzle-kit push):
# postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# Transaction Pooler (port 6543 - recommended for serverless queries):
# postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional inputs for the one-time admin bootstrap script (frontend/scripts/assign-admin.mjs)
ADMIN_EMAIL=
ADMIN_FULL_NAME=
