# Copy this file to `.env.local` and fill in the values.
# All values are exposed to the browser (NEXT_PUBLIC_*) — never put
# service-role or secret keys here.

# Supabase project settings (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Canonical origin for SEO, sitemap.xml and Open Graph URLs.
# Defaults to https://dahabhostel.com when unset.
NEXT_PUBLIC_BASE_URL=https://your-domain.com
