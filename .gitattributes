# Normalize line endings — LF in the repository, whatever the checkout OS.
* text=auto eol=lf

# Explicitly binary assets (never diff, never convert).
*.webp binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.eot  binary

# Windows shell scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
